<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kelseyde</groupId>
    <artifactId>calvin-chess-engine</artifactId>
    <version>6.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>calvin-chess-engine</name>
    <description>A chess engine written in Java.</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <native.maven.plugin.version>1.1.14</native.maven.plugin.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.nnue</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <!-- Compile Calvin as Java 17 bytecode -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <release>${java.version}</release>

                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Normal Calvin JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>

                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>
                                com.kelseyde.calvin.Application
                            </mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Preserve NNUE files without filtering -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>

                <configuration>
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>nnue</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>

            <!-- JUnit tests using the Vector API -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>

                <configuration>
                    <argLine>
                        --add-modules jdk.incubator.vector
                    </argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ============================================================ -->
    <!-- GraalVM Native Image / Android ARM64                         -->
    <!-- ============================================================ -->

    <profiles>

        <profile>
            <id>native</id>

            <build>

                <plugins>

                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>

                        <extensions>true</extensions>

                        <configuration>

                            <mainClass>
                                com.kelseyde.calvin.Application
                            </mainClass>

                            <imageName>
                                Calvin-android-arm64
                            </imageName>

                            <buildArgs>

                                <!-- Do not produce a fallback JVM image -->
                                <buildArg>--no-fallback</buildArg>

                                <!-- Android AArch64 target -->
                                <buildArg>
                                    --target=android-aarch64
                                </buildArg>

                                <!-- Android Bionic libc -->
                                <buildArg>
                                    --libc=bionic
                                </buildArg>

                                <!-- Existing Calvin HTTP support -->
                                <buildArg>
                                    --enable-url-protocols=http
                                </buildArg>

                                <!-- Initialize supported classes during build -->
                                <buildArg>
                                    --initialize-at-build-time
                                </buildArg>

                                <!-- Native Image optimization -->
                                <buildArg>-O2</buildArg>

                                <!-- Better Native Image diagnostics -->
                                <buildArg>
                                    -H:+ReportExceptionStackTraces
                                </buildArg>

                                <!-- Explicit Graal Vector API support -->
                                <buildArg>
                                    -H:+VectorAPISupport
                                </buildArg>

                                <!-- Calvin uses Java Vector API -->
                                <buildArg>
                                    --add-modules=jdk.incubator.vector
                                </buildArg>

                            </buildArgs>

                        </configuration>

                        <executions>

                            <execution>
                                <id>build-native</id>

                                <phase>package</phase>

                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>

                        </executions>

                    </plugin>

                </plugins>

            </build>

        </profile>

    </profiles>

</project>
